{
    "name": "Be Prepared",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc && vite build",
        "generate-pwa-assets": "pwa-assets-generator",
        "reinstall": "rm -rf node_modules package-lock.json && npm install",
        "start": "vite",
        "test": "tsc -p tsconfig.test.json && node --import tsx --test \"src/**/*.test.ts\" \"experiments/**/*.test.mjs\"",
        "tunnel": "echo \"Your tunnel password: $(curl https://loca.lt/mytunnelpassword)\" && npx localtunnel -p 8080",
        "test:e2e": "playwright test",
        "test:e2e:docker": "docker run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work --tmpfs /work/node_modules:exec,mode=1777 -w /work mcr.microsoft.com/playwright:v1.63.0-noble bash -c 'npm ci --no-audit --no-fund && npx playwright test \"$@\"' --",
        "size": "node scripts/size-report.mjs"
    },
    "type": "module",
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.6.4",
        "@vite-pwa/assets-generator": "^1.0.2",
        "fudgel": "^3.3.0",
        "node-stream-zip": "^1.15.0",
        "rxjs": "^7.8.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-simple-html": "^1.1.0",
        "vite-plugin-version-mark": "^0.2.2"
    },
    "dependencies": {
        "@bencevans/kalman-filter": "^1.0.0",
        "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
        "@types/ecef-projector": "^1.0.2",
        "@types/suncalc": "^1.9.2",
        "@types/w3c-generic-sensor": "^1.0.10",
        "@undecaf/zbar-wasm": "^0.11.0",
        "cheap-ruler": "^4.1.0",
        "ecef-projector": "^1.0.1",
        "qrcode-generator": "^2.0.4",
        "suncalc": "^2.0.1",
        "usng.js": "^0.4.5"
    }
}
